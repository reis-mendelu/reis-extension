      "existing": [
        { "id": "l1", "date": "2026-10-09", "hash": "1" },
        { "id": "l2", "date": "2026-10-09", "hash": "2" },
        { "id": "l3", "date": "2026-10-09", "hash": "3" }
      ]
    },
    "expected": { "insert": [], "update": [], "remove": ["l2", "l3"], "held": null }
  },
