{
  "name": "reis",
  "private": true,
  "version": "5.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt --browser firefox",
    "build": "wxt build",
    "build:firefox": "wxt build --browser firefox",
    "build:watch": "npx nodemon --watch src -e ts,tsx,html,css --exec 'npm run build'",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip --browser firefox",
    "lint": "eslint .",
    "preview": "wxt preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "xvfb-run -a playwright test",
    "test:e2e:headed": "xvfb-run -a playwright test --headed",
    "test:serenity": "xvfb-run -a playwright test e2e/serenity/specs",
    "test:smoke": "xvfb-run -a playwright test e2e/serenity/specs/smoke.spec.ts",
    "test:e2e:setup": "playwright install chromium",
    "typecheck": "tsc -b",
    "typecheck:nuia": "tsc -p tsconfig.app.json --noUncheckedIndexedAccess --noEmit",
    "nuia:gate": "node scripts/nuia-gate.mjs",
    "scrape:real": "tsx --tsconfig tsconfig.app.json scripts/scrape-real-data.ts",
    "dev:web": "vite --config vite.web.config.ts",
    "dev:web:admin": "VITE_DEV_SOCIETY= node scripts/with-secrets.mjs vite --config vite.web.config.ts",
    "dev:web:reis-admin": "VITE_DEV_SOCIETY=reis VITE_DEV_ADMIN_ROLE=reis_admin vite --config vite.web.config.ts",
    "dev:web:mock": "VITE_USE_MOCK_DATA=true vite --config vite.web.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:ui": "tsx --tsconfig tsconfig.app.json scripts/shot.ts",
    "dev:web:exams": "REIS_FIXTURE=examSeason vite --config vite.web.config.ts",
    "dev:web:week": "REIS_FIXTURE=teachingWeek vite --config vite.web.config.ts",
    "build:capacitor": "vite build --config vite.capacitor.config.ts",
    "cap:sync": "npm run check:native && npm run build:capacitor && npx cap sync && npm run ios:version",
    "cap:android": "npm run cap:sync && npx cap run android",
    "cap:ios": "npm run cap:sync && npx cap run ios",
    "android:apk": "node scripts/android-release.mjs apk",
    "android:aab": "node scripts/android-release.mjs aab",
    "android:feature-graphic": "node scripts/gen-feature-graphic.mjs",
    "ios:version": "tsx --tsconfig tsconfig.app.json scripts/sync-ios-version.ts",
    "store:shots": "node scripts/store-shots.mjs",
    "check:native": "node scripts/check-native-plugins.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capgo/capacitor-inappbrowser": "^8.15.3",
    "@fontsource/inter": "^5.3.0",
    "@reis/capacitor-eduroam": "file:native/capacitor-eduroam",
    "@reis/capacitor-secure-store": "file:native/capacitor-secure-store",
    "@supabase/supabase-js": "^2.112.4",
    "clsx": "^2.1.1",
    "daisyui": "^5.7.22",
    "date-fns": "^4.4.0",
    "file-saver": "^2.0.5",
    "idb": "^8.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.34.0",
    "motion": "^13.1.1",
    "p-limit": "^7.3.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-pdf": "^10.5.0",
    "react-resizable-panels": "^4.12.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "vaul": "^1.1.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.57.0",
    "@serenity-js/assertions": "^3.45.9",
    "@serenity-js/console-reporter": "^3.45.9",
    "@serenity-js/core": "^3.45.9",
    "@serenity-js/playwright": "^3.45.9",
    "@serenity-js/playwright-test": "^3.45.9",
    "@serenity-js/web": "^3.37.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/chrome": "^0.2.7",
    "@types/file-saver": "^2.0.7",
    "@types/jsdom": "^30.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.4.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "^3.2.7",
    "@wxt-dev/module-react": "^1.1.5",
    "baseline-browser-mapping": "^2.11.19",
    "concurrently": "^10.0.5",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.8",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.4",
    "wxt": "^0.21.4"
  },
  "overrides": {
    "shell-quote": "^1.8.4",
    "tmp": "^0.2.7",
    "uuid": "^11.1.1",
    "picomatch@2": "^2.3.2"
  }
}
