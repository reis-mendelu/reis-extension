{
  "name": "reis",
  "private": true,
  "version": "5.5.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt --browser firefox",
    "build": "wxt build",
    "build:firefox": "wxt build --browser firefox",
    "build:watch": "npx nodemon --watch src -e ts,tsx,html,css --exec 'npm run build'",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip --browser firefox",
    "lint": "eslint .",
    "preview": "wxt preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "xvfb-run -a playwright test",
    "test:e2e:headed": "xvfb-run -a playwright test --headed",
    "test:serenity": "xvfb-run -a playwright test e2e/serenity/specs",
    "test:smoke": "xvfb-run -a playwright test e2e/serenity/specs/smoke.spec.ts",
    "test:e2e:setup": "playwright install chromium",
    "typecheck": "tsc -b",
    "db:fingerprint": "bash supabase/scripts/compare-fingerprint.sh",
    "typecheck:nuia": "tsc -p tsconfig.app.json --noUncheckedIndexedAccess --noEmit",
    "nuia:gate": "node scripts/nuia-gate.mjs",
    "scrape:real": "tsx --tsconfig tsconfig.app.json scripts/scrape-real-data.ts",
    "sanitise:snapshot": "tsx --tsconfig tsconfig.app.json scripts/sanitise-snapshot.mjs",
    "dev:web": "vite --config vite.web.config.ts",
    "dev:web:admin": "VITE_DEV_SOCIETY= vite --config vite.web.config.ts",
    "dev:web:reis-admin": "VITE_DEV_SOCIETY=reis VITE_DEV_ADMIN_ROLE=reis_admin vite --config vite.web.config.ts",
    "dev:web:mock": "VITE_USE_MOCK_DATA=true vite --config vite.web.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:ui": "tsx --tsconfig tsconfig.app.json scripts/shot.ts",
    "emoji:fetch": "tsx --tsconfig tsconfig.app.json scripts/emoji/fetch-event-emoji.ts",
    "dev:web:exams": "REIS_FIXTURE=examSeason vite --config vite.web.config.ts",
    "dev:web:deadlines": "REIS_FIXTURE=notificationFeed vite --config vite.web.config.ts",
    "dev:web:boxes": "REIS_FIXTURE=submissionBoxes vite --config vite.web.config.ts",
    "dev:web:week": "REIS_FIXTURE=teachingWeek vite --config vite.web.config.ts",
    "build:web": "node scripts/assert-web-build-env.mjs && VITE_DEV_SOCIETY=reis VITE_PREVIEW_BUILD=true vite build --config vite.web.build.config.ts",
    "build:web:real": "test -f public/preview-data.json || (echo 'Missing public/preview-data.json — run npm run sanitise:snapshot first' && exit 1) && VITE_PREVIEW_DATA=real npm run build:web",
    "build:capacitor": "vite build --config vite.capacitor.config.ts",
    "cap:sync": "npm run check:native && npm run build:capacitor && npx cap sync && npm run ios:version",
    "cap:android": "npm run cap:sync && npx cap run android",
    "cap:ios": "npm run cap:sync && npx cap run ios",
    "android:apk": "node scripts/android-release.mjs apk",
    "android:aab": "node scripts/android-release.mjs aab",
    "android:push": "node scripts/android-push.mjs",
    "android:feature-graphic": "node scripts/gen-feature-graphic.mjs",
    "release:ios": "tsx --tsconfig tsconfig.app.json scripts/release-ios.ts",
    "ios:version": "tsx --tsconfig tsconfig.app.json scripts/sync-ios-version.ts",
    "store:shots": "node scripts/store-shots.mjs",
    "check:native": "node scripts/check-native-plugins.mjs",
    "preview:real": "npm run scrape:real && npm run sanitise:snapshot && npm run build:web:real && vite preview --config vite.web.build.config.ts",
    "check:app": "tsx --tsconfig tsconfig.app.json scripts/check-app.ts",
    "preview:real:lan": "echo \"\n⚠  Serving YOUR real academic record to every device on this network.\n   On eduroam or any shared Wi-Fi that is everyone.\n   Use this only on a network you trust, and stop it when you are done.\n\" && npm run scrape:real && npm run sanitise:snapshot && npm run build:web:real && vite preview --config vite.web.build.config.ts --host",
    "gen:splash": "tsx scripts/gen-splash.mts",
    "shot:route": "tsx --tsconfig tsconfig.app.json scripts/shot-route.ts",
    "privacy:generate": "tsx scripts/privacy/generate.ts",
    "privacy:publish": "tsx scripts/privacy/publish.ts",
    "mcp:build": "vite build --config vite.mcp.config.ts",
    "mcp:smoke": "npm run mcp:build && node scripts/mcp-smoke.mjs",
    "mcp:pack": "npm run mcp:build && node scripts/mcp-pack.mjs",
    "mcp:plugin": "vite build --config vite.mcp.plugin.config.ts && node scripts/mcp-plugin.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/app-launcher": "^8.0.1",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capgo/capacitor-inappbrowser": "^8.26.1",
    "@fontsource/inter": "^5.3.0",
    "@reis/capacitor-eduroam": "file:native/capacitor-eduroam",
    "@reis/capacitor-mac-save": "file:native/capacitor-mac-save",
    "@reis/capacitor-pdf-ink": "file:native/capacitor-pdf-ink",
    "@reis/capacitor-secure-store": "file:native/capacitor-secure-store",
    "@supabase/supabase-js": "^2.118.0",
    "clsx": "^2.1.1",
    "daisyui": "^5.7.50",
    "date-fns": "^4.4.0",
    "file-saver": "^2.0.5",
    "idb": "^8.0.4",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "jszip": "^3.10.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.61.0",
    "motion": "^14.5.0",
    "p-limit": "^7.3.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-pdf": "^11.0.0",
    "react-resizable-panels": "^4.14.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1",
    "vaul": "^1.1.2",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@playwright/test": "^1.57.0",
    "@serenity-js/assertions": "^3.49.0",
    "@serenity-js/console-reporter": "^3.49.0",
    "@serenity-js/core": "^3.49.0",
    "@serenity-js/playwright": "^3.49.0",
    "@serenity-js/playwright-test": "^3.49.0",
    "@serenity-js/web": "^3.37.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/chrome": "^0.3.6",
    "@types/file-saver": "^2.0.7",
    "@types/jsdom": "^30.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "^5.0.1",
    "@wxt-dev/module-react": "^1.1.5",
    "baseline-browser-mapping": "^2.11.30",
    "concurrently": "^10.0.6",
    "dotenv": "^18.0.8",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "jsdom": "^30.1.3",
    "officeparser": "^8.2.0",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.7",
    "vitest": "^5.0.1",
    "wxt": "^0.21.4"
  },
  "overrides": {
    "shell-quote": "^1.8.4",
    "tmp": "^0.2.7",
    "uuid": "^11.1.1",
    "picomatch@2": "^2.3.2"
  }
}
