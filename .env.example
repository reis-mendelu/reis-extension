# Local secrets for reIS. Copy to `.env` (gitignored) and fill in what you need —
# every entry is optional, and the scripts that use one say so when it is missing.
# Nothing here is a client secret: the Supabase URL and publishable key are
# hardcoded in src/services/supabase/config.ts, because a key shipped to a client
# is not a secret. See "No client secrets by design" in CLAUDE.md.

# IS Mendelu login — used by e2e tests and scripts/scrape-real-data.ts
# (`npm run scrape:real`, which backs the localhost real-data dev webapp).
MENDELU_USER=your_username
MENDELU_PASS=your_password

# Dev-only offline "society" for testing the organizer UI without a Supabase
# login. Defaults to "reis" for `npm run dev:web` (set in vite.web.config.ts);
# set an association id here to also enable it under `wxt dev`. Stripped from
# prod builds — `npm run build:web` refuses to build with any VITE_* variable
# that is not on its allowlist (scripts/assert-web-build-env.mjs).
VITE_DEV_SOCIETY=reis

# Real society / reIS-admin login for `npm run dev:web:admin`, which clears
# VITE_DEV_SOCIETY so publishes reach live Supabase instead of the in-memory dev
# store. Read by the Vite dev server (dev/adminSessionPlugin.ts), never by the
# browser, so the password stays out of the client bundle. Leave blank and the
# console just shows its normal login screen.
REIS_ADMIN_EMAIL=
REIS_ADMIN_PASSWORD=

# Optional per-society logins. The reis_admin above already authors for every
# society via the console's picker, so these are only needed to see what a
# single association sees: `REIS_ADMIN_SOCIETY=esn npm run dev:web:admin`.
# Ids: esn, supef, af, ldf, zf, au_frrms, reis.
# REIS_SOCIETY_ESN_EMAIL=
# REIS_SOCIETY_ESN_PASSWORD=

# App Store Connect, for `npm run release:ios` (scripts/lib/ascApi.ts). The
# private key itself stays a file in ~/.appstoreconnect/private_keys and never
# becomes a variable; ASC_KEY_ID is inferred when exactly one key is installed.
# ASC_ISSUER_ID=
# ASC_KEY_ID=

# Android upload key, only if you sign from the environment instead of
# android/keystore.properties (docs/android-beta-release.md). REIS_KEYSTORE_KEY_PASSWORD
# is optional — with a PKCS12 keystore the store password is the key password.
# REIS_KEYSTORE_FILE=
# REIS_KEYSTORE_PASSWORD=
# REIS_KEYSTORE_ALIAS=
# REIS_KEYSTORE_KEY_PASSWORD=
