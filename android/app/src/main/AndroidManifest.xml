<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- allowBackup is FALSE, against the Capacitor template's default: the app
         keeps a live UISAuth session token in SharedPreferences, and Android
         auto-backup would copy it to the user's cloud backup and to any
         device-to-device transfer. Nothing here is worth backing up anyway —
         every byte of reIS data is re-synced from IS on first launch.
         dataExtractionRules covers Android 12+, where allowBackup alone no
         longer governs device transfer. -->
    <!-- enableOnBackInvokedCallback is REQUIRED, not optional, at targetSdk 36.
         Android 16 turns predictive back on by default: the back *gesture* goes
         straight to the platform OnBackInvokedDispatcher, and with no callback
         registered there the system just finishes the activity — so swiping back
         anywhere closed the app instead of popping a sheet. The legacy KEYCODE_BACK
         path kept working the whole time (verified on device), which is what made
         this look like it worked. Setting this lets AndroidX's
         OnBackPressedDispatcher — which @capacitor/app registers its backButton
         callback on — receive the gesture too. -->
    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:targetApi="31"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Runtime-requested on Android 13+; without it the download notification
         is silently dropped (the file still saves). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- eduroam setup (EduroamPlugin). Both are normal permissions — granted at
         install, no runtime prompt. The network itself is saved by Android's own
         dialog via ACTION_WIFI_ADD_NETWORKS, not by us. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!-- Plugin manifests merge their own permissions in; privacy:check reads them
         (scripts/privacy/androidPermissions.ts). @capacitor/local-notifications
         adds RECEIVE_BOOT_COMPLETED (reschedules reminders after a restart) and
         WAKE_LOCK, both kept. The two below are stripped:
         - SCHEDULE_EXACT_ALARM (local-notifications): reminders are inexact with
           allowWhileIdle (src/services/eventReminders/sync.ts), which needs no
           permission. Declaring it only put an "Alarms & reminders" switch in
           Settings for a capability reIS never uses.
         - CAMERA (@capgo/capacitor-inappbrowser): the in-app browser only shows
           the IS sign-in and external links. The report screenshot input has no
           `capture`, and with CAMERA undeclared a camera intent needs no
           permission at all — declared-but-denied is what would break it. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" tools:node="remove" />
    <uses-permission android:name="android.permission.CAMERA" tools:node="remove" />
</manifest>
